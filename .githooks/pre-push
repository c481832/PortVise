#!/usr/bin/env bash
# Pre-push hook — mirrors the CI lint and test jobs.
# Install once: git config core.hooksPath .githooks

set -euo pipefail

echo "→ ruff check"
uv run ruff check .

echo "→ ruff format --check"
uv run ruff format --check .

echo "→ pytest"
uv run pytest

echo "✓ all checks passed"
