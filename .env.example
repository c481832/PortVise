# LLM configuration — override any value by uncommenting and editing.
# Restart the app after changing these. The web UI can also set per-run overrides (sidebar: Model & endpoints).
#
# LLM_BASE_URL=http://localhost:8003/v1
# LLM_MODEL=Qwen3.5-35B-A3B-UD-Q6_K_S.gguf
# Extra model names for the UI dropdown (comma-separated), in addition to LLM_MODEL and FAST_LLM_MODEL.
# LLM_MODEL_OPTIONS=other-model.gguf,another.gguf
# FAST_LLM_BASE_URL=http://localhost:8000/v1
# FAST_LLM_MODEL=Qwen2.5-7B-Instruct-Q4_K_M.gguf
# LLM_API_KEY=dummy
# LLM_CONNECT_TIMEOUT=30
# LLM_READ_TIMEOUT=1200
# LLM_MAX_RETRIES=2
