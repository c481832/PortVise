# Environment overrides (mainly for Docker). Prefer config.local.toml when running locally.
# Empty values are ignored. Restart the app after changing these.
#
# Cloud OpenAI-compatible endpoint:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=your_api_key_here
#
# Local OpenAI-compatible server:
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen3.5-9B-Q4_K_M.gguf
#
# News search credentials for the provider chosen by `search.provider` in config.toml:
# SEARXNG_URL=http://127.0.0.1:8888
# TAVILY_API_KEY=
# FRED_API_KEY=
#
# Application log file; relative paths resolve from the repository root.
# ADVISOR_LOG_FILE=logs/advisor.log
#
# Sharing through Cloudflare Tunnel + Access (see README.md, "Sharing with Cloudflare"):
# ADVISOR_LOCK_SETTINGS=true
# TUNNEL_TOKEN=paste_the_token_from_the_cloudflare_dashboard
