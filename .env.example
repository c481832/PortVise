# LLM configuration — cloud OpenAI-compatible endpoints are the recommended
# first-run path. Restart the app after changing these. The web UI can also set
# per-run overrides (sidebar: Model & endpoints).
#
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=your_api_key_here
#
# Local/Ollama-compatible endpoints also work if your machine has enough
# capacity for the selected models:
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen3.5-9B-Q4_K_M.gguf
#
# Extra model names for the UI dropdown (comma-separated), in addition to
# LLM_MODEL.
# LLM_MODEL_OPTIONS=other-model,another-model
#
# Extra ChatOpenAI constructor arguments by model, as JSON. Use "*" for defaults.
# LLM_MODEL_EXTRA_ARGS={"Qwen3.6-35B-A3B-UD-Q8_K_XL.gguf":{"extra_body":{"chat_template_kwargs":{"enable_thinking":false}}}}
#
# News search uses one provider, chosen by `search.provider` in config.toml or the settings UI
# ("searxng" default, or "tavily"). These override the chosen provider's credential:
# SEARXNG_URL=http://127.0.0.1:8888
# TAVILY_API_KEY=
# SEARCH_CONCURRENT_REQUESTS=4
# LLM_CONNECT_TIMEOUT=30
# LLM_READ_TIMEOUT=1200
# LLM_MAX_RETRIES=2
#
# Application log file (``port.*`` loggers); same lines also go to stderr. Leave empty to disable file logging.
# Relative paths are resolved from the repository root (not the process cwd).
# PORT_LOG_FILE=logs/port.log
# PORT_LOG_MAX_BYTES=10485760
# PORT_LOG_BACKUP_COUNT=5
